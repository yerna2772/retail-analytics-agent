# === LLM ===
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# === BigQuery ===
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# === Postgres ===
POSTGRES_DSN=postgresql://agent:agent@localhost:5432/agent

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Langfuse (optional — runs fine without) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === App ===
LOG_LEVEL=INFO
MAX_REPAIR_ATTEMPTS=3
MAX_LLM_CALLS=8
MAX_BYTES_SCANNED=16106127360
