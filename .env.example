# === GCP (Vertex AI + BigQuery) ===
# Set GCP_PROJECT_ID to enable Vertex AI (Gemini 2.5 Flash) and real BigQuery.
# Authenticate with: gcloud auth application-default login
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# === LLM (alternative to Vertex AI) ===
# If GCP_PROJECT_ID is not set, the agent tries these keys in order.
# Get a free Gemini key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# === Postgres ===
POSTGRES_DSN=postgresql://agent:agent@localhost:5432/agent

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === Langfuse (optional — runs fine without) ===
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# === App ===
LOG_LEVEL=INFO
MAX_REPAIR_ATTEMPTS=3
MAX_LLM_CALLS=8
MAX_BYTES_SCANNED=16106127360
